# Copy to .env for local development of the demo app.
# Use the same value as your backend's SHOPAGENT_API_KEY (backend/.env).
# Note: unlike the backend's .env, this value ends up inside the built
# JavaScript bundle and is visible to anyone using the widget in a browser -
# that's expected for a "publishable" key, not a secret one.
VITE_SHOPAGENT_API_KEY=
