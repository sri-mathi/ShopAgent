# Copy this file to .env and fill in your OWN credentials.
# ShopAgent-OS never ships or shares maintainer API keys - every developer
# running this project brings their own, for every service listed below.

# Required - the agent cannot make LLM calls without this.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional - enables Langfuse tracing (observability). The agent runs fine
# without these; you simply won't get traces in a Langfuse dashboard.
# Get free keys at https://cloud.langfuse.com (Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use https://us.cloud.langfuse.com instead if your project is in the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
